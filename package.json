{
  "name": "toolkit",
  "private": true,
  "description": "斯潘塞个人 Agent 工具集",
  "keywords": [
    "pi-package"
  ],
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@toolkit/config": "workspace:*",
    "@types/node": "^22.20.1",
    "rolldown": "1.2.0",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "packageManager": "bun@1.3.14"
}
